{
  "name": "event-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c magenta,cyan \"next dev -H 127.0.0.1 -p ${PORT:-3100}\" \"tsx watch --clear-screen=false src/worker/main.ts\"",
    "dev:web": "next dev -H 127.0.0.1 -p ${PORT:-3100}",
    "worker": "tsx src/worker/main.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c magenta,cyan \"next start -H 127.0.0.1 -p ${PORT:-3100}\" \"tsx src/worker/main.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx scripts/spike.ts",
    "import:drive": "tsx scripts/import-drive.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "openai": "^7.27.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "ulid": "^3.0.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
