# Sul Mac: copia questo file in .env.local oppure incolla la chiave nell'app (Impostazioni), che la scrive qui.
# .env.local è escluso da git e resta solo sul tuo Mac.
DASHSCOPE_API_KEY=
# Regione Singapore (internazionale). Se usi il nuovo dominio di workspace, sostituisci l'host.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# Cartella dei dati locali (database, PDF, immagini, export). Predefinita: ./data
# DATA_DIR=

# ── Online (Vercel) ── queste si impostano nel progetto Vercel, mai qui né nel codice ──────────────
# Primo amministratore: vale solo finché il database non ha utenti; al primo accesso la password va cambiata.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Database Turso e archivio Blob: li aggiungono le integrazioni di Vercel quando li colleghi al progetto.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# ── Solo per provare sul Mac il comportamento online ─────────────────────────────────────────────
# AUTH_REQUIRED=1        login obbligatorio anche in locale
# RUN_MODE=dispatch      lavori AI avviati come in cloud (serve anche APP_URL)
# APP_URL=http://127.0.0.1:3100
