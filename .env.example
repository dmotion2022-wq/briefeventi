# Copia questo file in .env.local e inserisci la tua chiave Alibaba Model Studio (DashScope).
# In alternativa incollala nell'app, in Impostazioni: la scrive qui lei (il file è nascosto in Finder).
# La chiave resta solo sul tuo Mac: .env.local è escluso da git.
DASHSCOPE_API_KEY=
# Regione Singapore (internazionale). Se usi il nuovo dominio di workspace, sostituisci l'host.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# Cartella dei dati locali (database, PDF, immagini, export). Predefinita: ./data
# DATA_DIR=
# Cartella "MVP SUPPLIERS" sincronizzata con Google Drive per desktop (facoltativa)
# DRIVE_LOCAL_PATH=
